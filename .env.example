# SMT Catering — Configuración de Entorno Local y Producción

# Puerto del servidor backend (Node.js nativo / Express)
PORT=3001

# URL de conexión a base de datos PostgreSQL en Neon Cloud (en local si no se define usa SQLite de respaldo)
DATABASE_URL=postgresql://usuario:password@ep-xyz.neon.tech/neondb?sslmode=require

# Secreto para firma de cookies JWT (opcional, tiene fallback en desarrollo)
JWT_SECRET=tu-clave-secreta-de-produccion

# URL de la API consumida por el cliente frontend (en desarrollo el proxy de Vite redirige /api a este puerto)
VITE_API_URL=http://localhost:3001

